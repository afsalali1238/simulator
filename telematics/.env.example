# ─────────────────────────────────────────────────────────────────────────────
# .env.example — THE CONFIG CONTRACT.
#
# Every environment variable the code reads is listed here, with its default.
# `src/config.js` is the only place these are consumed; if you add a var there,
# add it here in the same commit (the P0 config-hygiene rule).
#
# Nothing here is required: the whole slice runs with NO .env at all —
# `npm run demo` and `npm test` use the defaults below and the in-memory store.
# Copy this file to `.env` only when you want to change something.
#
# ⚠ `.env` is git-ignored and must stay that way. Never commit real credentials;
#   the placeholders below are deliberately fake.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Store selection ─────────────────────────────────────────────────────────
# Which store adapter to use:
#   memory (default) — in-process, zero dependencies, no Docker. Models the
#                      invariants at the application layer.
#   pg               — real PostgreSQL: tenancy enforced by row-level security,
#                      evidence immutability by a trigger. Needs Docker +
#                      `npm install`. This is the P1 phase.
DB=memory

# ─── Database (only read when DB=pg) ─────────────────────────────────────────
# Local dev points at the Docker Postgres from docker-compose.yml.
# The dev team swaps this for the AWS RDS / me-central-1 URL in production.
DATABASE_URL=postgres://dozr:***@localhost:5432/dozr_telematics

# App-role URL used by the API and by the RLS tenancy test. This role is NOT a
# superuser and does NOT own the tables, so row-level security actually applies
# to it (a superuser/owner bypasses RLS). Created by db/schema.sql.
# Falls back to DATABASE_URL if unset — which would make the RLS test vacuous,
# so set it properly when running the P1 gate.
APP_DATABASE_URL=postgres://dozr_app:***@localhost:5432/dozr_telematics

# ─── Ingestion server (the "device receiver") ────────────────────────────────
INGEST_HOST=0.0.0.0
# 5027 is the conventional Teltonika TCP port (also Traccar's default).
INGEST_PORT=5027

# Per-source-IP throttle on failed (unknown-IMEI) handshakes — P0 hardening.
# The handshake is the only gate on the ingestion port and an IMEI is not a
# secret, so without this a script can try IMEIs against the port all day.
# After HANDSHAKE_MAX_FAILURES failures from one IP within HANDSHAKE_WINDOW_MS,
# that IP is refused for HANDSHAKE_BLOCK_MS. A device that clears the
# handshake is never throttled by its own earlier failures — only a source
# that never lands a valid IMEI stays blocked. See
# src/ingestion/handshake-limiter.js.
HANDSHAKE_MAX_FAILURES=5
HANDSHAKE_WINDOW_MS=60000
HANDSHAKE_BLOCK_MS=300000

# Upper bound on a declared AVL data-field length, in bytes (F1 hardening). The
# framer waits for the declared number of bytes before acting; without a cap a
# peer can declare ~4 GB and drive one connection toward OOM. A real FMC130
# packet is a few hundred bytes to a few KB, so 65536 is far above any genuine
# frame. A packet declaring more than this is refused (connection dropped, no
# ACK) instead of buffered.
INGEST_MAX_PACKET_BYTES=65536

# Socket timeouts, in ms (F6 hardening). A silent/slow client otherwise holds a
# socket and its buffer indefinitely, which the handshake rate-limiter does not
# cover. INGEST_HANDSHAKE_TIMEOUT_MS is the deadline to send the IMEI frame
# (short); after a successful handshake the socket relaxes to
# INGEST_IDLE_TIMEOUT_MS between packets (generous — above a lifelike reporting
# interval). Either firing destroys the socket and the device reconnects. Set
# 0 to disable a given timer.
INGEST_HANDSHAKE_TIMEOUT_MS=10000
INGEST_IDLE_TIMEOUT_MS=600000

# Optional cap on concurrent connections (F6). 0 = unlimited (default). Set >0
# to have the server refuse sockets past the cap.
INGEST_MAX_CONNECTIONS=0

# ─── Read API (what the fleet-v2 dashboard would call) ───────────────────────
API_PORT=8080

# ─── Simulator (pretends to be one or more Teltonika units) ──────────────────
SIM_SERVER_HOST=127.0.0.1
SIM_SERVER_PORT=5027
# 8E = Codec 8 Extended (what an FMC130 typically sends). Also supports 8.
SIM_CODEC=8E
# Delay between records, in ms. 0 = send as fast as the server ACKs (what the
# tests and CI use); 1000 is a lifelike reporting interval to watch by eye.
SIM_INTERVAL_MS=1000

# Which named scenario to replay. `npm run sim:list` prints them all with what
# each one proves. The important two:
#   handover  — D1 changes hands at 2025-06-01T00:00:00Z (invariants 6, 9)
#   yard-idle — the unassigned D2 in the yard (invariants 3, 7, 9)
# Others: day-cycle (default), after-hours, geofence-cross, tamper.
# Set to `none` (or pass --stream) for the legacy indefinite soak stream.
SIM_SCENARIO=day-cycle

# Cap records per track when replaying a scenario. 0 = the whole scenario.
SIM_RECORDS=0

# How many devices from the seed roster to run in --stream (soak) mode. Ignored
# when replaying a scenario, since the scenario itself defines its tracks.
SIM_DEVICES=1

# Port for the browser control-panel server (src/tools/sim-control-server.js,
# started by `npm run dashboard`) — lets dashboard.html's scenario buttons
# trigger a real send and stream back the raw wire bytes. Dev-tooling only.
SIM_CONTROL_PORT=8081

# ─── Operability / logging ───────────────────────────────────────────────────
# Minimum level to emit: debug | info | warn | error | silent
LOG_LEVEL=info
# json (default — greppable, shippable off a pilot box) | kv (easier to read
# in a terminal)
LOG_FORMAT=json

# Hard deadline for a graceful drain on SIGINT/SIGTERM before the process forces
# an exit. Keep this BELOW the orchestrator's kill grace period (ECS defaults to
# 30s) or the platform will SIGKILL mid-drain.
SHUTDOWN_TIMEOUT_MS=10000

# ─── Test hooks (do not set in normal operation) ─────────────────────────────
# When "1", the store throws at the durability boundary and the ingestion server
# never ACKs — used by the durability test to prove we never ACK data we didn't
# persist (invariant 1). Leave empty in real runs.
FAIL_BEFORE_COMMIT=

# Floor for the test-count gate (`npm run test:gate`). Normally left unset: the
# real floor lives in src/tools/test-gate.js next to the suite it describes.
# Override only to test the gate itself.
MIN_TESTS=
